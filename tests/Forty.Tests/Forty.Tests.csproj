<Project Sdk="Microsoft.NET.Sdk">

  <!-- The test runner. A small console program instead of a test framework, so the tests run on this
       PC with no package downloads. Run it and read the pass/FAIL lines; the exit code is the number
       of failures. "Forty.Tests probe" prints what each Windows adapter reports right now, read-only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <RootNamespace>Forty.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Forty.Core\Forty.Core.csproj" />
    <ProjectReference Include="..\..\src\Forty.Motion\Forty.Motion.csproj" />
    <ProjectReference Include="..\..\src\Forty.Platform\Forty.Platform.csproj" />
  </ItemGroup>

</Project>
