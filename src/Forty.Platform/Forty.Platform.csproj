<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows sources: power, media sessions, Windows Focus, what kind of window is in front.
       Every adapter is driven by Windows events (nothing polls), reports its own health, and can be
       switched off for tests with FORTY_FAULT. Uses only the Windows SDK, not the App SDK. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <RootNamespace>Forty.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forty.Core\Forty.Core.csproj" />
  </ItemGroup>

</Project>
